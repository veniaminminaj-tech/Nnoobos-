<Window x:Class="CubeAntivirus.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cube Antivirus" Height="720" Width="1120" MinHeight="600" MinWidth="900" Background="#0D1520" Foreground="#E8F0F8" WindowStartupLocation="CenterScreen"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><StackPanel><TextBlock Text="CUBE ANTIVIRUS" FontSize="25" FontWeight="Bold" Foreground="#38D996"/><TextBlock Text=".NET 8 · Security &amp; System Diagnostics" Foreground="#91A4B8"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="● PROTECTION READY" Foreground="#38D996" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><Border Background="#172231" CornerRadius="12" Padding="14" Margin="0,0,10,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="File scanner" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><TextBox x:Name="PathBox" Text="C:\Users" Padding="9" Background="#0D1520" Foreground="White"/><WrapPanel Margin="0,8,0,12"><Button Content="Scan folder" Click="Scan_Click" Padding="14,8" Margin="0,0,8,0"/><Button Content="Refresh processes" Click="Processes_Click" Padding="14,8"/></WrapPanel></StackPanel><ListBox x:Name="ResultsList" Background="#101A28" BorderThickness="0" Foreground="White"/></DockPanel></Border><Border Grid.Column="1" Background="#172231" CornerRadius="12" Padding="14" Margin="10,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Cube Terminal" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><TextBox x:Name="TerminalOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" Vertical